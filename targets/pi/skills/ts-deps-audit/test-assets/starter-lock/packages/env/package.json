{
  "name": "@starter/env",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Environment variables, validated once at import time.",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./load": {
      "types": "./dist/load.d.ts",
      "import": "./dist/load.js",
      "default": "./dist/load.js"
    },
    "./create-env": {
      "types": "./dist/create-env.d.ts",
      "import": "./dist/create-env.js",
      "default": "./dist/create-env.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.13",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "files": [
    "dist"
  ]
}
