{
  "name": "@starter/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared React primitives and design tokens.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/utils": "./src/lib/utils.ts"
  },
  "scripts": {
    "check-types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@starter/types": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "19.0.14",
    "@types/react-dom": "19.0.6",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "^5.7.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
