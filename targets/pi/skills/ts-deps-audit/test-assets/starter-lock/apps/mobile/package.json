{
  "name": "@starter/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "Expo client. Same contracts as web, different transport layer.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "check:compatibility": "expo install --check",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "dev": "expo start"
  },
  "dependencies": {
    "@react-navigation/elements": "2.9.39",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@starter/types": "workspace:*",
    "expo": "~54.0.7",
    "expo-constants": "~18.0.9",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@starter/config": "workspace:*",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.11",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react-dom": "19.1.0",
    "typescript": "~5.9.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
